// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  STUDENT
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  passwordHash  String
  role          Role
  createdAt     DateTime     @default(now())

  // Relations
  classes       Class[]      @relation("ClassCoach")
  enrollments   Enrollment[]
  attendance    Attendance[] @relation("StudentAttendance")
  materials     Material[]
}

model Class {
  id           String       @id @default(uuid())
  className    String
  coachId      String
  scheduleTime String
  createdAt    DateTime     @default(now())

  // Relations
  coach        User         @relation("ClassCoach", fields: [coachId], references: [id])
  enrollments  Enrollment[]
  attendance   Attendance[]
  materials    Material[]
}

model Enrollment {
  id        String @id @default(uuid())
  studentId String
  classId   String

  // Relations
  student   User   @relation(fields: [studentId], references: [id])
  class     Class  @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}

model Attendance {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  date      DateTime @db.Date
  status    String   // "PRESENT" or "ABSENT"
  markedBy  String
  timestamp DateTime @default(now())

  // Relations
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation("StudentAttendance", fields: [studentId], references: [id])

  @@unique([classId, studentId, date])
}

model Material {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  classId    String?
  uploadedBy String
  createdAt  DateTime @default(now())

  // Relations
  class      Class?   @relation(fields: [classId], references: [id])
  uploader   User     @relation(fields: [uploadedBy], references: [id])
}
