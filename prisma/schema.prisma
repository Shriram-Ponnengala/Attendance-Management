generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())
  attendance   Attendance[] @relation("StudentAttendance")
  classes      Class[]      @relation("ClassCoach")
  enrollments  Enrollment[]
  materials    Material[]
}

model Class {
  id           String       @id @default(uuid())
  className    String
  coachId      String
  scheduleTime String
  createdAt    DateTime     @default(now())
  attendance   Attendance[]
  coach        User         @relation("ClassCoach", fields: [coachId], references: [id])
  enrollments  Enrollment[]
  materials    Material[]
}

model Enrollment {
  id        String @id @default(uuid())
  studentId String
  classId   String
  class     Class  @relation(fields: [classId], references: [id])
  student   User   @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId])
}

model Attendance {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  date      DateTime @db.Date
  status    String
  markedBy  String
  timestamp DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation("StudentAttendance", fields: [studentId], references: [id])

  @@unique([classId, studentId, date])
}

model Material {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  classId    String?
  uploadedBy String
  createdAt  DateTime @default(now())
  class      Class?   @relation(fields: [classId], references: [id])
  uploader   User     @relation(fields: [uploadedBy], references: [id])
}

enum Role {
  ADMIN
  COACH
  STUDENT
}
